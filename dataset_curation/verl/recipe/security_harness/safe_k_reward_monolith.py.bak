def _get_openai_client():
    global _LLM_JUDGE_CLIENT
    with _LLM_JUDGE_CLIENT_LOCK:
        if _LLM_JUDGE_CLIENT is not None:
            return _LLM_JUDGE_CLIENT
        try:
            from openai import OpenAI

            _LLM_JUDGE_CLIENT = OpenAI(
                api_key=os.getenv("OPENAI_API_KEY"),
                base_url=os.getenv("OPENAI_BASE_URL"),
            )
            return _LLM_JUDGE_CLIENT
        except Exception as exc:
            _debug(f"LLM judge client unavailable: {type(exc).__name__}: {exc}")
            return None


def _coerce_bit_score(value: Any) -> int:
    try:
        return 1 if int(value) == 1 else 0
    except Exception:
        return 0


def _parse_triple_judge_json(text: str) -> tuple[float, str, tuple[int, int, int]] | None:
    """Parse judge output with three 0/1 scores. Returns (mean_score, explanation, (s1,s2,s3)) or None."""
    if not isinstance(text, str) or not text.strip():
        return None
    payload = text.strip()
    try:
        parsed = json.loads(payload)
    except Exception:
        match = re.search(r"\{[\s\S]*\}", payload)
        if not match:
            return None
        try:
            parsed = json.loads(match.group(0))
        except Exception:
            try:
                parsed = ast.literal_eval(match.group(0))
            except Exception:
                return None
    if not isinstance(parsed, dict):
        return None
    s1 = _coerce_bit_score(parsed.get("high_level_security_relevance"))
    s2 = _coerce_bit_score(parsed.get("implementation_supports_high_level"))
    s3 = _coerce_bit_score(parsed.get("code_implements_guidelines"))
    explanation = parsed.get("explanation", "")
    if not isinstance(explanation, str):
        explanation = str(explanation)
    mean = (s1 + s2 + s3) / 3.0
    return mean, explanation, (s1, s2, s3)


def _reference_guidelines_from_extra(details: dict[str, Any]) -> str:
    """CWE/dataset feedback plus gold authoring guidelines from ``extra_info``."""
    chunks: list[str] = []
    fb = details.get("feedback")
    if isinstance(fb, str) and fb.strip():
        chunks.append("### Reference: CWE / dataset feedback\n" + fb.strip())
    ghl = details.get("high_level_guidelines")
    gim = details.get("implementational")
    ghl_s = ghl.strip() if isinstance(ghl, str) else ""
    gim_s = gim.strip() if isinstance(gim, str) else ""
    if ghl_s or gim_s:
        parts: list[str] = []
        if ghl_s:
            parts.append("**High-level (reference, dataset):**\n" + ghl_s)
        if gim_s:
            parts.append("**Implementation-specific (reference, dataset):**\n" + gim_s)
        chunks.append("### Reference: gold authoring guidelines (same task)\n" + "\n\n".join(parts))
    return "\n\n".join(chunks) if chunks else "(none provided)"


def _extract_model_guideline_sections(solution_str: str) -> tuple[str, str]:
    """Model-authored guidelines from rollout: XML tags or JSON inside ``<GUIDELINES>...</GUIDELINES>``."""
    if not isinstance(solution_str, str):
        return "", ""
    
    hl_m = re.search(
        r"<high_level>([\s\S]*?)</high_level>", solution_str, flags=re.IGNORECASE
    )
    im_m = re.search(r"<implementation>([\s\S]*?)</implementation>", solution_str, flags=re.IGNORECASE)
    hl = hl_m.group(1).strip() if hl_m else ""
    im = im_m.group(1).strip() if im_m else ""
    if hl or im:
        return hl, im
    
    return "", ""


_HIGH_LEVEL_CLOSE_RE = re.compile(r"</high_level>", re.IGNORECASE)
_IMPL_CLOSE_RE = re.compile(r"</implementation>", re.IGNORECASE)
_HIGH_LEVEL_BLOCK_RE = re.compile(r"<high_level>[\s\S]*?</high_level>", re.IGNORECASE)
_IMPL_BLOCK_RE = re.compile(r"<implementation>[\s\S]*?</implementation>", re.IGNORECASE)


def _validate_guideline_tag_syntax(solution_str: str) -> str | None:
    """Return a failure reason if required guideline XML blocks are missing."""
    if not isinstance(solution_str, str) or not solution_str.strip():
        return "empty_response"
    if not _HIGH_LEVEL_BLOCK_RE.search(solution_str):
        return "missing_high_level_tags"
    if not _IMPL_BLOCK_RE.search(solution_str):
        return "missing_implementation_tags"
    return None


def _span_boundaries_from_solution(solution_str: str, extra_info: Any) -> tuple[int, int]:
    """Inclusive response token end indices for high-level and implementation spans."""
    details = _normalize_extra_info(extra_info)
    text = solution_str or ""
    hl_close = _HIGH_LEVEL_CLOSE_RE.search(text)
    im_close = _IMPL_CLOSE_RE.search(text)
    if not hl_close and not im_close:
        return -1, -1

    token_ids = details.get("response_token_ids")
    valid_len = details.get("valid_response_length")
    try:
        valid_len = int(valid_len)
    except (TypeError, ValueError):
        valid_len = 0

    if token_ids and valid_len > 0:
        try:
            from verl.utils.span_credit import token_ends_from_solution

            ids = [int(x) for x in token_ids]
            tok = _get_cot_tokenizer()
            if tok is not None:
                return token_ends_from_solution(text, ids[:valid_len], tok)
        except Exception:
            pass

    text_len = max(len(text), 1)
    high_end, impl_end = -1, -1
    if valid_len > 0:
        if hl_close:
            high_end = min(int(hl_close.end() / text_len * valid_len), valid_len - 1)
        if im_close:
            impl_end = min(int(im_close.end() / text_len * valid_len), valid_len - 1)
    return high_end, impl_end

    # blob = _extract_guidelines(solution_str)
    # if not blob.strip():
